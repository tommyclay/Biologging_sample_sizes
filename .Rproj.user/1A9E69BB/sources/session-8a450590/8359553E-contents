# WGS84 projection
proj_dec <- "+proj=longlat +datum=WGS84 +no_defs +ellps=WGS84 +towgs84=0,0,0"   

colony <- data.frame(Longitude = -38.05, Latitude = -90)
proj_col <- paste0("+proj=laea +lat_0=", colony$Latitude, " +lon_0=", colony$Longitude, " +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs +ellps=WGS84 +towgs84=0,0,0")


