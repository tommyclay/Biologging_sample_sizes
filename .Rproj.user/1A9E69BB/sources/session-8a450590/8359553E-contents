######## WA - INC - GPS - DONE ##########

wa <- subset(all.tracks, SPECIES == "WALB",)
wa_inc <- subset(wa, STAGE == "INC",)
wa_inc <- subset(wa_inc, DEVICE == "GPS",)
wa_inc$RING <- as.factor(as.character(wa_inc$RING))
wa_inc$id <- as.factor(as.character(wa_inc$RING))
wa_inc$longitude <- wa_inc$LON
wa_inc$latitude <- wa_inc$LAT

wa_inc_res <- resampling_UD_area(x = wa_inc, n_iter = 1000, 
                          iso_level = 95, cellsize = 10000, h = 50000, proj_in = proj_dec,
                          proj_out = proj_col, n_core = 6)
ggplot(wa_inc_res, aes(sample, tot_area)) + geom_line(aes(group = factor(iteration)))

# plotting
wa_inc_res$tot_area <- wa_inc_res$tot_area/1000000

# paste out
write.csv(wa_inc_res, paste0(out.direx, "GPS_WAINC", "_1k_95.csv"))


