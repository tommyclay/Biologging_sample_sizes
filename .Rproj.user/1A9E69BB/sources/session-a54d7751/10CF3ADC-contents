### creating a function ####

pred_df <- data.frame(ba = seq(0.05, 1, 0.01))


pred_fun <- function(pred_df) {
  # Compute predictions
  pred_df$prediction <- -3.9926/log(1-pred_df$ba)
  # Compute the gradient manually: derivative w.r.t k
  grad_matrix <- matrix(1 / log(1 - pred_df$ba), ncol = 1)  # Ensure it's a matrix
  # Compute standard error of predictions from vcov of model
  se_fit <- sqrt(grad_matrix^2 * 0.05120739)
  # Compute 95% confidence intervals
  alpha <- 0.05
  z_score <- qnorm(1 - alpha / 2)  # 1.96 for 95% CI
  pred_df$upper <- pred_df$prediction + z_score * se_fit
  pred_df$lower <- pred_df$prediction - z_score * se_fit
  return(pred_df)
}

pred_df <- pred_fun(pred_df)

plot(x, y, pch=16, col="blue", main="NLS Prediction with 95% CI (Delta Method)")
lines(pred_df$ba, pred_df$prediction, col="red", lwd=2)
lines(pred_df$ba, pred_df$upper, col="black", lty=2)
lines(pred_df$ba, pred_df$lower, col="black", lty=2)
