boot_nls <- function(data, indices) {
  d <- data[indices, ]  # Resample data
  
  # Try fitting the model
  fit <- try(nls(y ~ k / log(1 - x), data = d, start = list(k = -10)), silent = TRUE)
  
  # Handle convergence issues
  if (inherits(fit, "try-error")) return(rep(NA, length(new_x$x)))
  
  # Predict using new x values
  predict(fit, newdata = data.frame(x = seq(0.01, 0.99, length.out = 100)))
}

# Perform bootstrapping
boot_results <- boot(data_frame, boot_nls, R = 1000)  # 1000 resamples

# Compute confidence intervals
ci_lower <- apply(boot_results$t, 2, function(x) quantile(x, 0.025, na.rm = TRUE))
ci_upper <- apply(boot_results$t, 2, function(x) quantile(x, 0.975, na.rm = TRUE))
